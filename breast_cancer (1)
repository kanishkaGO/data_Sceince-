":"markdown","metadata":{"id":"a2731c7c"},"source":["You can upload files directly through the Colab interface! Just look for the folder icon on the left sidebar, click it, and then click the upload icon (an arrow pointing up) to select your file. After uploading, you can read the file into a pandas DataFrame like this:"]},{"cell_type":"code","source":["# 1. Load & Organize WDBC Attributes\n","raw_bunch = load_breast_cancer(as_frame=True)\n","df_raw = raw_bunch.frame.copy()\n","# Map target label to WDBC conventions (0: Malignant, 1: Benign in sklearn)\n","df_raw[\"diagnosis\"] = df_raw[\"target\"].map({0: \"M\", 1: \"B\"})\n","features = raw_bunch.feature_names.tolist()\n","X_ground_truth = df_raw[features].copy()\n","\n","# Audit Data Quality\n","print(f\"Dataset Shape: {df_raw.shape}\")\n","print(f\"Duplicate rows: {df_raw.duplicated().sum()}\")\n","print(f\"Missing values: {df_raw.isnull().sum().sum()}\")\n","\n","# Extreme value audit via IQR method\n","q1 = X_ground_truth.quantile(0.25)\n","q3 = X_ground_truth.quantile(0.75)\n","iqr = q3 - q1\n","outliers = ((X_ground_truth < (q1 - 1.5 * iqr)) | (X_ground_truth > (q3 + 1.5 * iqr))).sum()\n","print(f\"Top 3 features with highest outlier counts:\\n{outliers.nlargest(3)}\\n\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"-8gnf02NecCn","executionInfo":{"status":"ok","timestamp":1788454186037,"user_tz":-330,"elapsed":9,"user":{"displayName":"Kanishka Goswami","userId":"15829161088387758016"}},"outputId":"56bceb92-7524-4ae0-c900-02feb214054a"},"execution_count":9,"outputs":[{"output_type":"stream","name":"stdout","text":["Dataset Shape: (569, 32)\n","Duplicate rows: 0\n","Missing values: 0\n","Top 3 features with highest outlier counts:\n","area error         65\n","radius error       38\n","perimeter error    38\n","dtype: int64\n","\n"]}]},{"cell_type":"code","source":["# 2. Inject Controlled 5% Missing Completely At Random (MCAR)\n","X_missing = X_ground_truth.copy()\n","total_cells = X_ground_truth.size\n","n_missing = int(0.05 * total_cells)\n","\n","mask_flat = np.zeros(total_cells, dtype=bool)\n","mask_flat[:n_missing] = True\n","np.random.shuffle(mask_flat)\n","missing_mask = mask_flat.reshape(X_ground_truth.shape)\n","X_missing[missing_mask] = np.nan\n","\n","# 3. Recover Missing Values via KNN Imputation vs Mean Imputation\n","knn_imp = KNNImputer(n_neighbors=5)\n","X_knn_imputed = pd.DataFrame(knn_imp.fit_transform(X_missing), columns=features)\n","X_mean_imputed = X_missing.fillna(X_missing.mean())\n","\n","# Quantitative Imputation Evaluation (RMSE on injected cells)\n","rmse_knn = np.sqrt(np.mean((X_ground_truth.values[missing_mask] - X_knn_imputed.values[missing_mask]) ** 2))\n","rmse_mean = np.sqrt(np.mean((X_ground_truth.values[missing_mask] - X_mean_imputed.values[missing_mask]) ** 2))\n","\n","print(f\"Mean Imputation RMSE: {rmse_mean:.4f}\")\n","print(f\"KNN Imputation RMSE:  {rmse_knn:.4f}\")\n","# KNN preserves multivariate local correlations better; adopt KNN-imputed data\n","X_clean = X_knn_imputed.copy()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"URA_1GApi7lj","executionInfo":{"status":"ok","timestamp":1788454186093,"user_tz":-330,"elapsed":57,"user":{"displayName":"Kanishka Goswami","userId":"15829161088387758016"}},"outputId":"4f524cf0-af3d-4244-a0c6-a6858b1e1530"},"execution_count":10,"outputs":[{"output_type":"stream","name":"stdout","text":["Mean Imputation RMSE: 100.7169\n","KNN Imputation RMSE:  23.5844\n"]}]},{"cell_type":"code","source":["#transformation\n","skew_before = X_clean.apply(stats.skew)\n","high_skew_cols = skew_before[skew_before > 1.5].index.tolist()\n","print(f\"Attributes with high positive skew (> 1.5): {high_skew_cols}\")\n","\n","X_transformed = X_clean.copy()\n","for col in high_skew_cols:\n","    X_transformed[col] = np.log1p(np.maximum(0, X_transformed[col]))\n","\n","skew_after = X_transformed[high_skew_cols].apply(stats.skew)\n","skew_comparison = pd.DataFrame({\"Skew_Before\