area, and mean radius\n","nuclear_size_index = (X_zscore[\"mean radius\"] + X_zscore[\"mean perimeter\"] + X_zscore[\"mean area\"]) / 3.0\n","X_zscore[\"nuclear_size_index\"] = nuclear_size_index"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"Ze43do_XsSBY","executionInfo":{"status":"ok","timestamp":1788454186194,"user_tz":-330,"elapsed":16,"user":{"displayName":"Kanishka Goswami","userId":"15829161088387758016"}},"outputId":"0dc55cfd-4987-4f08-cee6-66ecae457212"},"execution_count":12,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","Scaling Verification (first feature: 'mean radius'):\n","Z-Score -> Mean: 1.94e-16, Std: 1.0009\n","Min-Max -> Min:  0.0000, Max: 1.0000\n"]}]},{"cell_type":"code","source":["print(\"\\n--- TASK 3: AGGREGATION & DATA REDUCTION ---\")\n","\n","# 1. Correlation-Based Redundancy Reduction\n","corr_matrix = X_zscore[features].corr().abs()\n","upper_tri = corr_matrix.where(np.triu(np.ones(corr_matrix.shape), k=1).astype(bool))\n","to_drop = [col for col in upper_tri.columns if any(upper_tri[col] > 0.90)]\n","X_corr_reduced = X_zscore[features].drop(columns=to_drop)\n","\n","reduction_ratio_corr = len(to_drop) / len(features)\n","print(f\"Identified {len(to_drop)} redundant features with Pearson |r| > 0.90: {to_drop}\")\n","print(f\"Correlation Filter Reduction Ratio: {reduction_ratio_corr * 100:.2f}% (Retained {X_corr_reduced.shape[1]} features)\")\n","\n","# 2. Dimensionality Reduction via PCA (Preserving >= 95% Variance)\n","pca = PCA(n_components=0.95, random_state=42)\n","X_pca = pca.fit_transform(X_zscore[features])\n","var_retained = np.sum(pca.explained_variance_ratio_)\n","\n","print(f\"Original Dimension: {len(features)} -> PCA Dimension: {X_pca.shape[1]}\")\n","print(f\"PCA Total Retained Variance: {var_retained * 100:.2f}%\")\n","\n","# 3. Distributional Similarity Validation (Kolmogorov-Smirnov Test)\n","# Test KS distance between PC1 and original dominant size metric ('mean radius')\n","ks_stat, p_val = stats.ks_2samp(X_zscore[\"mean radius\"], X_pca[:, 0])\n","print(f\"KS Statistic between 'mean radius' and PC1: {ks_stat:.4f} (p-value: {p_val:.4e})\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"pfBxUltCuPB_","executionInfo":{"status":"ok","timestamp":1788454186251,"user_tz":-330,"elapsed":61,"user":{"displayName":"Kanishka Goswami","userId":"15829161088387758016"}},"outputId":"eea5a561-8021-4d4f-f71d-33207422f95a"},"execution_count":13,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","--- TASK 3: AGGREGATION & DATA REDUCTION ---\n","Identified 8 redundant features with Pearson |r| > 0.90: ['mean perimeter', 'mean area', 'mean concave points', 'perimeter error', 'area error', 'worst radius', 'worst perimeter', 'worst area']\n","Correlation Filter Reduction Ratio: 26.67% (Retained 22 features)\n","Original Dimension: 30 -> PCA Dimension: 12\n","PCA Total Retained Variance: 95.77%\n","KS Statistic between 'mean radius' and PC1: 0.4394 (p-value: 9.4752e-50)\n"]}]},{"cell_type":"code","source":["# TASK 4: Discretization, Concept Hierarchy and Final Validation\n","# ==============================================================================\n","print(\"\\n--- TASK 4: DISCRETIZATION & FINAL VALIDATION ---\")\n","\n","target_attr = \"mean radius\"\n","attr_data = X_clean[[target_attr]]\n","\n","# 1. Discretization Comparison: Equal-Width vs Equal-Frequency\n","ew_disc = KBinsDiscretizer(n_bins=4, encode=\"ordinal\", strategy=\"uniform\", random_state=42)\n","ef_disc = KBinsDiscretizer(n_bins=4, encode=\"ordinal\", strategy=\"quantile\", random_state=42)\n","\n","ew_bins = ew_disc.fit_transform(attr_data).flatten()\n","ef_bins = ef_disc.fit_transform(attr_data).flatten()\n","\n","# Shannon Entropy Calculation: H(X) = -sum(p * log2(p))\n","def entropy(labels):\n","    probs = pd.Series(labels).value_counts(normalize=True)\n","    return -np.sum(probs * np.log2(probs + 1e-12))\n","\n","h_ew = entropy(ew_bins)\n","h_ef = entropy(ef_bins)\n","nmi_ew = normalized_mutual_info_score(df_raw[\"diagnosis\"], ew_bins)\n","nmi_ef = normalized_mutual_info_score(df_raw[\"diagnosis\"], ef_bins)\n","\n","print(f\"Equal-Width Entropy:     {h_ew:.4f} bits | NMI with Diagnosis: {nmi_ew:.4f}\")\n","print(f\"Equal-Frequency Entropy: {h_ef:.4f} bits | NMI with Diagnosis: {nmi_ef:.4f}\")\n","\n","# 2. Concept Hierarchy Formulation (Level 0: Raw -> Level 1: Quintiles -> Level 2: Binary Category)\n","cut_edges = np.quantile(attr_data[target_attr], [0, 0.33, 0.66, 1.0])\n","labels_l1 = [\"Small\", \"Moderate\", \"Large\"]\n","labels_l2 = [\"Benign-Likely\", \"Malignant-Likely\"]\n","\n","concept_level_1 = pd.cut(attr_data[target_attr], bins=cut_edges, labels=labels_l1, include_lowest=True)\n","concept_level_2 = pd.cut(attr_data[target_attr], bins=[-np.inf, np.median(attr_data[target_attr]), np.inf], labels=labels_l2)\n","\n","concept_hierarchy_sample = pd.DataFrame({\n","    \"Raw_Value\": attr_data[target_attr].head(5),\n","    \"Level_1_Morphology\": concept_level_1.head(5),\n","    \"Level_2_Class_Profile\": concept_level_2.head(5)\n","})\n","print(\"\\nConcept Hierarchy Mapping Sample:\\n\", concept_hierarchy_sample)\n","\n","# 3. Final Preprocessing Pipeline Validation Audit\n","pipeline_metrics = {\n","    \"Metric\": [\n","        \"Completeness (% missing)\",\n","        \"Dimensionality (Number of Features)\",\n","        \"Max Pearson Redundancy\",\n","        \"Retained Variance (PCA)\",\n","        \"Peak Kurtosis\"\n","    ],\n","    \"Raw Data\": [\n","        f\"{df_raw.isna().mean().mean() * 100:.1f}%\",\n","        f\"{len(features)}\",\n","        f\"{upper_tri.max().max():.4f}\",\n","        \"100.0%\",\n","        f\"{df_raw[features].kurtosis().max():.2f}\"\n","    ],\n","    \"Processed Data\": [\n","        f\"{X_clean.isna().mean().mean() * 100:.1f}%\",\n","        f\"{X_pca.shape[1]} (via PCA) / {X_corr_reduced.shape[1]} (via Filter)\",\n","        f\"{X_corr_reduced.corr().abs().where(~np.eye(X_corr_reduced.shape[1], dtype=bool)).max().max():.4f}\",\n","        f\"{var_retained * 100:.2f}%\",\n","        f\"{pd.DataFrame(X_pca).kurtosis().max():.2f}\"\n","    ]\n","}\n","\n","validation_table = pd.DataFrame(pipeline_metrics)\n","print(\"\\nPipeline Verification Audit:\")\n","print(validation_table.to_string(index=False))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"zxD5NrmdurYj","executionInfo":{"status":"ok","timestamp":1788454186274,"user_tz":-330,"elapsed":32,"user":{"displayName":"Kanishka Goswami","userId":"15829161088387758016"}},"outputId":"fb247e7c-faf2-4772-9564-70a216099771"},"execution_count":14,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","--- TASK 4: DISCRETIZATION & FINAL VALIDATION ---\n","Equal-Width Entropy:     1.5731 bits | NMI with Diagnosis: 0.3217\n","Equal-Frequency Entropy: 2.0000 bits | NMI with Diagnosis: 0.3341\n","\n","Concept Hierarchy Mapping Sample:\n","    Raw_Value Level_1_Morphology Level_2_Class_Profile\n","0      17.99              Large      Malignant-Likely\n","1      20.57              Large      Malignant-Likely\n","2      19.69              Large      Malignant-Likely\n","3      11.42              Small         Benign-Likely\n","4      20.29              Large      Malignant-Likely\n","\n","Pipeline Verification Audit:\n","                             Metric Raw Data                 Processed Data\n","           Completeness (% missing)     0.0%                           0.0%\n","Dimensionality (Number of Features)       30 12 (via PCA) / 22 (via Filter)\n","             Max Pearson Redundancy   0.9973                         0.8742\n","            Retained Variance (PCA)   100.0%                         95.77%\n","                      Peak Kurtosis    49.21                           5.73\n"]}]}]}